+            &EpochScheduleState {
+                subnet_epoch_index: u64::MAX,
+                ..state()
+            },
+            1
+        ),
+        Err(EpochScheduleError::BoundExceeded)
+    );
+    assert_eq!(
+        predict_first_reveal_block(
+            &EpochScheduleState {
+                tempo: 0,
+                ..state()
+            },
+            1
+        ),
+        Err(EpochScheduleError::TempoIsZero)
+    );
+}
