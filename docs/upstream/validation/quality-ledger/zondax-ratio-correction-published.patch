Subject: [PATCH] fix: keep TaoBalance price fields in raw units

---
 app/src/metadata_parser.c                 | 12 +++++
 docs/format.md                            |  6 +++
 tests/ledger_quality.cpp                  | 59 +++++++++++++++++++++++
 tests/quality/README.md                   | 21 ++++++++
 tests/quality/relative-price-v478.json    | 20 ++++++++
 tests/supported_chains/bittensor-477.json |  6 +--
 6 files changed, 121 insertions(+), 3 deletions(-)
 create mode 100644 tests/ledger_quality.cpp
 create mode 100644 tests/quality/README.md
 create mode 100644 tests/quality/relative-price-v478.json

diff --git a/app/src/metadata_parser.c b/app/src/metadata_parser.c
index 7a0b4a4..ff25b4e 100644
--- a/app/src/metadata_parser.c
+++ b/app/src/metadata_parser.c
@@ -82,6 +82,18 @@ static parser_error_t checkBalanceEncoding(Field_t *field, PrintItem_t *printIte
         return parser_ok;
     }
 
+    // Subtensor reuses TaoBalance for both native amounts and prices. A
+    // limit_price may be TAO per alpha or a relative exchange ratio; neither
+    // has the native token's unit alone. Keep these fields as raw integers.
+    const char *const taoBalanceType = "TaoBalance";
+    const char *const limitPriceField = "limit_price";
+    if (field->name.hasBytes && field->name.bytes.len == strlen(PIC(limitPriceField)) &&
+        strncmp((const char *)field->name.bytes.ptr, PIC(limitPriceField), field->name.bytes.len) == 0 &&
+        field->typeName.bytes.len == strlen(PIC(taoBalanceType)) &&
+        strncmp((const char *)field->typeName.bytes.ptr, PIC(taoBalanceType), field->typeName.bytes.len) == 0) {
+        return parser_ok;
+    }
+
     // Check if we should skip balance formatting for pallets that handle non-native tokens
     // These tokens have their own decimals/symbols stored on-chain
     const bool skipFormatting = shouldSkipBalanceFormatting(printItem);
diff --git a/docs/format.md b/docs/format.md
index fb5998f..b02c05b 100644
--- a/docs/format.md
+++ b/docs/format.md
@@ -53,6 +53,12 @@ T::Balance
 TaoBalance
 ```
 
+Fields named `limit_price` with type name `TaoBalance` are displayed as raw
+integers. Subtensor uses that type for prices per alpha and for relative
+exchange ratios, so applying the native token's symbol would assert an
+incorrect unit. Other `TaoBalance` amount fields use the native token's decimals
+and symbol.
+
 By using the appropriate type, the application ensures that amounts are displayed correctly, enhancing the overall usability.
 
 ## Address Formatting
diff --git a/tests/ledger_quality.cpp b/tests/ledger_quality.cpp
new file mode 100644
index 0000000..12bc71d
--- /dev/null
+++ b/tests/ledger_quality.cpp
@@ -0,0 +1,59 @@
+// Native amount and relative-price unit regression.
+#include <app_mode.h>
+#include <gtest/gtest.h>
+#include <hexutils.h>
+
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <nlohmann/json.hpp>
+
+#include "parser.h"
+#include "utils/common.h"
+
+TEST(BalanceFormatting, RelativePricesRemainRawInDirectAndNestedCalls) {
+    std::ifstream file(std::string(TESTVECTORS_DIR) + "quality/relative-price-v478.json");
+    ASSERT_TRUE(file.is_open());
+    nlohmann::json vectors;
+    file >> vectors;
+    ASSERT_EQ(vectors.size(), 3);
+    for (const auto &entry : vectors) {
+        for (bool expert : {false, true}) {
+            SCOPED_TRACE(entry["name"].get<std::string>() + (expert ? " expert" : " normal"));
+            app_mode_set_expert(expert);
+            uint8_t buffer[16384] = {0};
+            const auto blob = entry["blob"].get<std::string>();
+            const auto proof = entry["metadata"].get<std::string>();
+            const auto digestHex = entry["digest"].get<std::string>();
+            const auto blobLen = parseHexString(buffer, sizeof(buffer), blob.c_str());
+            const auto proofLen = parseHexString(buffer + blobLen, sizeof(buffer) - blobLen, proof.c_str());
+            ASSERT_NE(blobLen, 0);
+            ASSERT_NE(proofLen, 0);
+            parser_tx_t transaction = {0};
+            ASSERT_EQ(parser_parse(&transaction, buffer, blobLen + proofLen, blobLen), parser_ok);
+            uint8_t digest[32] = {0};
+            ASSERT_EQ(parseHexString(digest, sizeof(digest), digestHex.c_str()), 32);
+            ASSERT_EQ(memcmp(digest, transaction.metadataDigest, sizeof(digest)), 0);
+            auto lines = genericDumpUI(&transaction);
+            ASSERT_FALSE(lines.empty());
+            unsigned ratios = 0;
+            unsigned amounts = 0;
+            for (const auto &line : lines) {
+                if (line.find("limit_price") != std::string::npos) {
+                    std::cout << entry["name"].get<std::string>() << (expert ? " expert " : " normal ") << line << '\n';
+                    EXPECT_NE(line.find("limit_price : 950000000"), std::string::npos);
+                    EXPECT_EQ(line.find("TAO"), std::string::npos);
+                    ratios++;
+                }
+                if (line.find("alpha_amount") != std::string::npos) {
+                    EXPECT_NE(line.find("alpha_amount : 2000000000"), std::string::npos);
+                    EXPECT_EQ(line.find("TAO"), std::string::npos);
+                    amounts++;
+                }
+            }
+            const unsigned expected = entry["name"] == "batch_swap_move" ? 2 : 1;
+            EXPECT_EQ(ratios, expected);
+            EXPECT_EQ(amounts, expected);
+        }
+    }
+}
