+/// fabricated name: the caller must pass the runtime that executed the block.
+pub fn decode(runtime: &Runtime, value: &Value) -> Result<Option<DispatchErrorInfo>, CoreError> {
+    if matches!(value, Value::Null) {
+        return Ok(None);
