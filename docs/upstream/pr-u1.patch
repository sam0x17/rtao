+            "Token" => match variant {
+                Value::Dict(entries) if !entries.is_empty() => entries
+                    .first()
+                    .map(|(key, _)| python_str(key))
+                    .unwrap_or_default(),
+                _ => python_str(variant),
+            },
+            "Arithmetic" | "Transactional" => match variant {
+                Value::Dict(entries) if !entries.is_empty() => entries
+                    .first()
+                    .map(|(key, _)| python_str(key))
+                    .unwrap_or_default(),
+                _ => name.into(),
+            },
+            _ => name.into(),
+        };
