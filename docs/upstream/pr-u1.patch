+//!
+//! Portable JSON-RPC request construction and SCALE response decoding.
+
+pub mod dispatch_error;
+pub mod extrinsic_lookup;
+pub mod fee;
+pub mod metadata;
+pub mod runtime_api;
+pub mod storage;
+
+/// One JSON-RPC method and its positional arguments, without a transport or ID.
+#[derive(Debug, Clone, PartialEq)]
+pub struct RpcRequest {
+    /// JSON-RPC method to invoke.
+    pub method: &'static str,
+    /// Positional JSON-RPC arguments.
+    pub params: serde_json::Value,
+}
diff --git a/sdk/bittensor-core/src/protocol/runtime_api.rs b/sdk/bittensor-core/src/protocol/runtime_api.rs
new file mode 100644
index 000000000..5971e10e1
--- /dev/null
+++ b/sdk/bittensor-core/src/protocol/runtime_api.rs
@@ -0,0 +1,105 @@
+// Derived from RaoFoundation/subtensor sdk/bittensor-core/src/client.rs @ 850f2755bb05a3851f948489f0ab27b0645cebce (Apache-2.0); modified by rtao.
+//!
+//! Runtime-API method lookup, positional argument encoding and result decoding.
+//!
+//! Extracted from `runtime_call` and `runtime_api_method` in
+//! `sdk/bittensor-core/src/client.rs` at subtensor v478
+//! (`850f2755bb05a3851f948489f0ab27b0645cebce`), Apache-2.0.
+
+use crate::{
+    codec::value::Value,
+    runtime::{type_string::TypeSpec, Runtime, RuntimeApiMethodInfo},
+    CoreError,
+};
+use serde_json::Value as JsonValue;
+
+use super::{metadata::response_bytes, RpcRequest};
+
+/// Borrow one method from the named API in live V15 metadata.
+///
+/// V14 metadata exposes no API signatures; archive fallback tables and API
+/// version policy belong to the caller.
+pub fn runtime_api_method<'a>(
+    runtime: &'a Runtime,
+    api: &str,
+    method: &str,
+) -> Result<&'a RuntimeApiMethodInfo, CoreError> {
+    runtime
+        .apis
+        .iter()
+        .find(|candidate| candidate.name == api)
+        .and_then(|candidate| {
+            candidate
+                .methods
+                .iter()
+                .find(|candidate| candidate.name == method)
+        })
+        .ok_or_else(|| CoreError::NotInRuntime(format!("runtime API {api}.{method}")))
+}
+
+/// Encode positional arguments in the metadata's exact input order.
+pub fn encode_params(
+    runtime: &Runtime,
+    api: &str,
+    method: &RuntimeApiMethodInfo,
+    params: &[Value],
+) -> Result<Vec<u8>, CoreError> {
+    if method.inputs.len() != params.len() {
+        return Err(CoreError::Codec(format!(
+            "{api}.{} expects {} params, got {}",
+            method.name,
+            method.inputs.len(),
+            params.len()
+        )));
+    }
+    let mut encoded = Vec::new();
+    for (input, value) in method.inputs.iter().zip(params.iter()) {
+        runtime.encode_id(input.ty, value, &mut encoded)?;
+    }
+    Ok(encoded)
+}
+
+/// Resolve and encode a `state_call` request, optionally at a pinned block.
+pub fn request(
+    runtime: &Runtime,
+    api: &str,
+    method: &str,
+    params: &[Value],
+    block_hash: Option<&str>,
+) -> Result<RpcRequest, CoreError> {
+    let info = runtime_api_method(runtime, api, method)?;
+    let encoded = encode_params(runtime, api, info, params)?;
+    let mut params = vec![
+        JsonValue::String(format!("{api}_{method}")),
+        JsonValue::String(format!("0x{}", hex::encode(encoded))),
+    ];
+    if let Some(hash) = block_hash {
+        params.push(JsonValue::String(hash.into()));
+    }
+    Ok(RpcRequest {
+        method: "state_call",
+        params: JsonValue::Array(params),
+    })
+}
+
+/// Decode a hex `state_call` result using the method's live output type.
+pub fn decode_result(
+    runtime: &Runtime,
+    method: &RuntimeApiMethodInfo,
+    result: &JsonValue,
+) -> Result<Value, CoreError> {
+    decode_bytes(
+        runtime,
+        method,
+        &response_bytes(result, "state_call result")?,
+    )
+}
+
+/// Decode the entire SCALE result, rejecting truncated or trailing bytes.
+pub fn decode_bytes(
+    runtime: &Runtime,
+    method: &RuntimeApiMethodInfo,
+    bytes: &[u8],
+) -> Result<Value, CoreError> {
+    runtime.decode_spec(&TypeSpec::Id(method.output), bytes, true)
+}
diff --git a/sdk/bittensor-core/src/protocol/storage.rs b/sdk/bittensor-core/src/protocol/storage.rs
new file mode 100644
index 000000000..e4adbe01a
--- /dev/null
+++ b/sdk/bittensor-core/src/protocol/storage.rs
@@ -0,0 +1,93 @@
+// Derived from RaoFoundation/subtensor sdk/bittensor-core/src/client.rs @ 850f2755bb05a3851f948489f0ab27b0645cebce (Apache-2.0); modified by rtao.
+//!
+//! Storage lookup, request construction and metadata-defined miss decoding.
+//!
+//! Extracted from `query`, `storage_raw`, `storage_info` and `decode_storage`
+//! in `sdk/bittensor-core/src/client.rs` at subtensor v478
+//! (`850f2755bb05a3851f948489f0ab27b0645cebce`), Apache-2.0.
+
+use crate::{
+    codec::value::Value,
+    runtime::{type_string::TypeSpec, Runtime, StorageInfo},
+    CoreError,
+};
+use serde_json::Value as JsonValue;
+
+use super::{metadata::decode_hex, RpcRequest};
+
+/// Borrow an entry from the live runtime, or report its missing pallet/item.
+pub fn storage_info<'a>(
+    runtime: &'a Runtime,
+    pallet: &str,
+    storage: &str,
+) -> Result<&'a StorageInfo, CoreError> {
+    runtime
+        .storage_entry(pallet, storage)
+        .ok_or_else(|| CoreError::NotInRuntime(format!("storage {pallet}.{storage}")))
+}
+
+/// Build a storage request using the live entry's key types and hashers.
+///
+/// The core permits a partial key prefix for map iteration. Callers fetching
+/// one map value must supply its complete key arguments.
+pub fn storage_request(
+    runtime: &Runtime,
+    info: &StorageInfo,
+    params: &[Value],
+    block_hash: Option<&str>,
+) -> Result<RpcRequest, CoreError> {
+    let key = runtime.storage_key(info, params)?;
+    let mut params = vec![JsonValue::String(format!("0x{}", hex::encode(key)))];
+    if let Some(hash) = block_hash {
+        params.push(JsonValue::String(hash.into()));
+    }
+    Ok(RpcRequest {
+        method: "state_getStorage",
+        params: JsonValue::Array(params),
+    })
+}
+
+/// Decode a `state_getStorage` result, rejecting values other than hex or null.
+pub fn decode_result(
+    runtime: &Runtime,
+    info: &StorageInfo,
+    result: &JsonValue,
+) -> Result<Value, CoreError> {
+    match result {
+        JsonValue::Null => decode_storage(runtime, info, None),
+        JsonValue::String(raw) => decode_storage(runtime, info, Some(raw)),
+        _ => Err(CoreError::Rpc(
+            "state_getStorage returned neither hex nor null".into(),
+        )),
+    }
+}
+
+/// Strictly decode a hex value, or apply the live entry's miss semantics.
+///
+/// An `Optional` miss returns `Value::Null`. A `Default` miss decodes the
+/// metadata's default bytes through the same type and complete-consumption
+/// checks as a present value.
+pub fn decode_storage(
+    runtime: &Runtime,
+    info: &StorageInfo,
+    raw: Option<&str>,
+) -> Result<Value, CoreError> {
+    match raw {
+        Some(raw) => decode_storage_bytes(runtime, info, Some(&decode_hex(raw)?)),
+        None => decode_storage_bytes(runtime, info, None),
+    }
+}
+
+/// Decode raw SCALE storage bytes, with the same default/optional semantics.
+pub fn decode_storage_bytes(
+    runtime: &Runtime,
+    info: &StorageInfo,
+    raw: Option<&[u8]>,
+) -> Result<Value, CoreError> {
+    let bytes = match raw {
+        Some(raw) => raw,
+        None if info.modifier == "Optional" => return Ok(Value::Null),
+        None => info.default_bytes.as_slice(),
+    };
+    runtime.decode_spec(&TypeSpec::Id(info.value_type), bytes, true)
+}
