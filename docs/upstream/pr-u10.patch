@@ -0,0 +1,57 @@
+//! Verify wallet-compatible password encoding without global environment writes.
+
+use std::error::Error;
+
+use bittensor_core::{
+    keyfile_env::{decode_password_from_environment, encode_password_for_environment},
+    CoreError,
+};
+
+#[test]
+fn encoding_matches_legacy_ascii_unicode_and_empty_vectors() -> Result<(), Box<dyn Error>> {
+    for (name, password, expected) in [
+        ("BT_PW_TEST", "native-test", "LDUrOSE6eTE2JzY="),
+        ("WALLET_α", "pässwörd\0\n", "J4LoPzYjnHjDM0FG"),
+        ("A", "", ""),
+        ("A", "a\0\n", "IEFL"),
+    ] {
+        assert_eq!(encode_password_for_environment(name, password)?, expected);
+        assert_eq!(decode_password_from_environment(name, expected)?, password);
+    }
+    Ok(())
+}
+
+#[test]
+fn empty_encoding_key_retains_the_legacy_error() {
+    assert!(matches!(
+        encode_password_for_environment("", "password"),
+        Err(CoreError::Crypto(message)) if message == "env var name must not be empty"
+    ));
+}
+
+#[test]
+fn encoding_does_not_create_or_replace_a_process_variable() -> Result<(), Box<dyn Error>> {
+    let name = format!("BT_PW_PURE_ENCODING_REGRESSION_{}", std::process::id());
+    let before = std::env::var_os(&name);
+    let value = encode_password_for_environment(&name, "test-password")?;
+    assert!(!value.is_empty());
+    assert_eq!(std::env::var_os(&name), before);
+    // Encoding is defined by UTF-8 bytes, independently of OS variable syntax.
+    assert!(!encode_password_for_environment("not=an\0os-variable", "secret")?.is_empty());
+    Ok(())
+}
+
+#[test]
+fn decoder_retains_whitespace_and_error_boundaries() -> Result<(), Box<dyn Error>> {
+    assert_eq!(
+        decode_password_from_environment("BT_PW_TEST", " \nLDUrOSE6eTE2JzY=\t ")?,
+        "native-test"
+    );
+    assert!(matches!(decode_password_from_environment("", ""),
+        Err(CoreError::Crypto(message)) if message == "env var name must not be empty"));
+    assert!(matches!(decode_password_from_environment("A", "!!!"),
+        Err(CoreError::Keyfile(message)) if message == "invalid base64 in wallet password env var"));
+    assert!(matches!(decode_password_from_environment("A", "vg=="),
+        Err(CoreError::Keyfile(message)) if message == "invalid wallet password env var: corrupt UTF-8"));
+    Ok(())
+}
diff --git a/sdk/bittensor-core/tests/verify_strict.rs b/sdk/bittensor-core/tests/verify_strict.rs
new file mode 100644
index 000000000..fe844f194
--- /dev/null
+++ b/sdk/bittensor-core/tests/verify_strict.rs
@@ -0,0 +1,81 @@
+//! Differential acceptance checks against the pinned core's public verifier.
+
+use std::error::Error;
+
+use bittensor_core::keys::verify_strict;
+use bittensor_core::keys::{self, Keypair, CRYPTO_ED25519, CRYPTO_SR25519};
+
+#[test]
+fn raw_signatures_verify_and_wrapped_signatures_are_rejected() -> Result<(), Box<dyn Error>> {
+    let payload = b"btauth/1\nPOST\n/submit?task=1\nbody\n123\nsender\n-";
+    for scheme in [CRYPTO_SR25519, CRYPTO_ED25519] {
+        let key = Keypair::from_seed(&[7; 32], scheme)?;
+        let address = key.ss58_address();
+        let signature = key.sign(payload)?;
+        assert!(verify_strict(payload, &signature, &address, scheme)?);
+        assert!(keys::verify(payload, &signature, &address, scheme)?);
+        assert!(!verify_strict(
+            b"changed message",
+            &signature,
+            &address,
+            scheme
+        )?);
+        let wrong_key = Keypair::from_seed(&[8; 32], scheme)?;
+        assert!(!verify_strict(
+            payload,
+            &signature,
+            &wrong_key.ss58_address(),
+            scheme
+        )?);
+        let wrapped = [
+            b"<Bytes>".as_slice(),
+            payload.as_slice(),
+            b"</Bytes>".as_slice(),
+        ]
+        .concat();
+        let wrapped_signature = key.sign(&wrapped)?;
+        assert!(keys::verify(payload, &wrapped_signature, &address, scheme)?);
+        assert!(!verify_strict(
+            payload,
+            &wrapped_signature,
+            &address,
+            scheme
+        )?);
+        assert!(verify_strict(
+            &wrapped,
+            &wrapped_signature,
+            &address,
+            scheme
+        )?);
+    }
+    Ok(())
+}
+
+#[test]
+fn malformed_encoding_matches_the_core_error_boundary() -> Result<(), Box<dyn Error>> {
+    for scheme in [CRYPTO_SR25519, CRYPTO_ED25519] {
+        let key = Keypair::from_seed(&[9; 32], scheme)?;
+        let address = key.ss58_address();
+        for signature in [vec![0; 63], vec![0; 65]] {
+            let strict = verify_strict(b"message", &signature, &address, scheme)
+                .err()
+                .ok_or("strict accepted wrong length")?;
+            let upstream = keys::verify(b"message", &signature, &address, scheme)
+                .err()
+                .ok_or("core accepted wrong length")?;
+            assert_eq!(strict.to_string(), upstream.to_string());
+        }
+        assert!(!verify_strict(b"message", &[0; 64], &address, scheme)?);
+        assert!(verify_strict(b"message", &[0; 64], "bad SS58", scheme).is_err());
+    }
+    let address = keys::ss58_from_public([255; 32], 42);
+    assert!(!verify_strict(
+        b"message",
+        &[0; 64],
+        &address,
+        CRYPTO_SR25519
+    )?);
+    let address = Keypair::from_seed(&[9; 32], CRYPTO_ED25519)?.ss58_address();
+    assert!(verify_strict(b"message", &[0; 64], &address, 255).is_err());
+    Ok(())
+}
