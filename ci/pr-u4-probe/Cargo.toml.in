[workspace]
resolver = "2"

[package]
name = "rtao-pr-u4-probe"
version = "0.1.0"
edition = "2021"
rust-version = "1.89"
publish = false

[dependencies]
bittensor-core = { path = "@CORE_PATH@", default-features = false }
w3f-bls = { version = "=0.1.3", features = ["std"] }
tle = { git = "https://github.com/ideal-lab5/timelock", rev = "5416406cfd32799e31e1795393d4916894de4468", features = ["std"] }
ark-serialize = "=0.4.2"
parity-scale-codec = { version = "3.7.5", features = ["derive"] }
rand_core = "0.6.4"
rand_chacha = "0.3.1"
sha2 = "0.10"
hex = "0.4.3"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
